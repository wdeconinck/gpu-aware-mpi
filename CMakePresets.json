{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ecmwf-hpc2020",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "CMAKE_CUDA_ARCHITECTURES": "80"
      }
    },
    {
      "name": "nvidia-24.5",
      "inherits": "ecmwf-hpc2020",
      "displayName": "ECMWF HPC2020 / NVIDIA 24.5",
      "description": "Use scripts/configure.sh --preset nvidia-24.5 to load the environment from vendor metadata.",
      "vendor": {
        "ecmwf.int/gpu-aware-mpi/1.0": {
          "environmentFile": "arch/ecmwf/hpc2020/nvidia/24.5/env.sh"
        }
      }
    },
    {
      "name": "nvidia-26.1",
      "inherits": "ecmwf-hpc2020",
      "displayName": "ECMWF HPC2020 / NVIDIA 26.1",
      "description": "Use scripts/configure.sh --preset nvidia-26.1 to load the environment from vendor metadata.",
      "vendor": {
        "ecmwf.int/gpu-aware-mpi/1.0": {
          "environmentFile": "arch/ecmwf/hpc2020/nvidia/26.1/env.sh"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "nvidia-24.5",
      "configurePreset": "nvidia-24.5",
      "inheritConfigureEnvironment": true
    },
    {
      "name": "nvidia-26.1",
      "configurePreset": "nvidia-26.1",
      "inheritConfigureEnvironment": true
    }
  ],
  "workflowPresets": [
    {
      "name": "nvidia-24.5",
      "displayName": "Configure, build, and test / NVIDIA 24.5",
      "steps": [
        { "type": "configure", "name": "nvidia-24.5" },
        { "type": "build", "name": "nvidia-24.5" },
        { "type": "test", "name": "nvidia-24.5" }
      ]
    },
    {
      "name": "nvidia-26.1",
      "displayName": "Configure, build, and test / NVIDIA 26.1",
      "steps": [
        { "type": "configure", "name": "nvidia-26.1" },
        { "type": "build", "name": "nvidia-26.1" },
        { "type": "test", "name": "nvidia-26.1" }
      ]
    }
  ],
  "testPresets": [
    {
      "name": "gpu-tests",
      "hidden": true,
      "inheritConfigureEnvironment": true,
      "output": {
        "verbosity": "extra",
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error"
      }
    },
    {
      "name": "nvidia-24.5",
      "inherits": "gpu-tests",
      "configurePreset": "nvidia-24.5",
      "displayName": "GPU integration tests / NVIDIA 24.5",
      "vendor": {
        "ecmwf.int/gpu-aware-mpi/1.0": {
          "sallocArguments": ["-q", "dg", "--nodes=1", "--gpus-per-task=1", "--tasks-per-node=4", "--cpus-per-task=1"]
        }
      }
    },
    {
      "name": "nvidia-26.1",
      "inherits": "gpu-tests",
      "configurePreset": "nvidia-26.1",
      "displayName": "GPU integration tests / NVIDIA 26.1",
      "vendor": {
        "ecmwf.int/gpu-aware-mpi/1.0": {
          "sallocArguments": ["-q", "dg", "--nodes=1", "--gpus-per-task=1", "--tasks-per-node=4", "--cpus-per-task=1"]
        }
      }
    }
  ]
}