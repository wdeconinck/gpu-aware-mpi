set(INTROSPECTED_CUDA_HOST_COMPILER "")
if(NOT INTROSPECT_CUDA_COMPILER)
    return()
endif()

set(host_arguments)
if(CUDA_HOST_COMPILER)
    list(APPEND host_arguments -ccbin "${CUDA_HOST_COMPILER}")
endif()

message(STATUS "CUDA host compiler debugging: inspecting NVCC's compiler commands (no benchmark is run).")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E echo ""
    COMMAND "${CUDA_COMPILER}" ${host_arguments} --dryrun -v -x cu -c -
    OUTPUT_VARIABLE raw_output
    ERROR_VARIABLE raw_error
    RESULTS_VARIABLE probe_results
)
string(APPEND raw_output "${raw_error}")
if(NOT "${probe_results}" STREQUAL "0;0")
    message(WARNING "NVCC debug probe failed (${probe_results}):\n${raw_output}")
    return()
endif()

set(probe_path "$ENV{PATH}")
if(raw_output MATCHES "#\\$ PATH=([^\r\n]*)")
    set(probe_path "${CMAKE_MATCH_1}")
endif()
string(REPLACE ":" ";" probe_path "${probe_path}")
string(REPLACE "\n" ";" output_lines "${raw_output}")
set(matched_commands)
set(host_paths)
foreach(output_line IN LISTS output_lines)
    if(NOT output_line MATCHES "^#\\$ (.*)")
        continue()
    endif()
    separate_arguments(command_arguments UNIX_COMMAND "${CMAKE_MATCH_1}")
    if(NOT command_arguments)
        continue()
    endif()
    list(GET command_arguments 0 compiler_command)
    get_filename_component(compiler_name "${compiler_command}" NAME)
    if(NOT compiler_name MATCHES "^(gcc|g\\+\\+|clang|clang\\+\\+|cl\\.exe|nvc|nvc\\+\\+)(-[0-9.]+)?$")
        continue()
    endif()
    list(APPEND matched_commands "${output_line}")
    if(IS_ABSOLUTE "${compiler_command}")
        list(APPEND host_paths "${compiler_command}")
    else()
        unset(resolved_compiler)
        find_program(resolved_compiler NAMES "${compiler_command}"
            PATHS ${probe_path} NO_DEFAULT_PATH NO_CACHE)
        if(resolved_compiler)
            list(APPEND host_paths "${resolved_compiler}")
        else()
            message(WARNING "Unable to resolve NVCC host command: ${compiler_command}")
        endif()
    endif()
endforeach()

list(REMOVE_DUPLICATES host_paths)
if(host_paths)
    list(GET host_paths 0 INTROSPECTED_CUDA_HOST_COMPILER)
endif()
foreach(host_path IN LISTS host_paths)
    message(STATUS "Host compiler introspected from NVCC: ${host_path}")
endforeach()
if(matched_commands)
    message(STATUS "=== Matched Compiler Lines ===")
    foreach(matched_command IN LISTS matched_commands)
        message("${matched_command}")
    endforeach()
else()
    message(WARNING "No standard host compiler command found. Raw NVCC output:\n${raw_output}")
endif()